// =============================================================================
// AUTO-GENERATED BY src/semantic_compiler.py FROM semantic/evm_semantic_model.toml
// Power BI Enterprise Semantic Measures (Composite Mode: Redshift DirectQuery)
// =============================================================================

// Total authorized baseline budget across scoped active project snapshots.
Budget at Completion (BAC) = SUM('fact_evm_daily'[bac_usd])

// Authorized budget assigned to scheduled work as of snapshot date (BCWS).
Planned Value (PV) = SUM('fact_evm_daily'[cum_pv_usd])

// Authorized budget value of physical work actually completed (BCWP).
Earned Value (EV) = SUM('fact_evm_daily'[cum_ev_usd])

// Cumulative actual delivery engineering labor cost from Kinesis worklog events.
Actual Labor Cost = SUM('fact_evm_daily'[cum_ac_labor_usd])

// Cumulative AWS & Databricks sandbox/production compute cost from Kinesis burn events.
Actual Cloud Spend = SUM('fact_evm_daily'[cum_ac_cloud_usd])

// Total cumulative cost incurred (Labor + Cloud Infrastructure) for work performed (ACWP).
Actual Cost (AC) = SUM('fact_evm_daily'[cum_ac_total_usd])

// [Variance] EV minus AC. Negative values indicate over-budget execution.
Cost Variance (CV) = [Earned Value (EV)] - [Actual Cost (AC)]

// [Variance] EV minus PV. Negative values indicate behind-schedule delivery.
Schedule Variance (SV) = [Earned Value (EV)] - [Planned Value (PV)]

// [Efficiency Index] Weighted portfolio cost efficiency (SUM(EV)/SUM(AC)). Strictly forbids naive AVG(CPI).
Cost Performance Index (CPI) = DIVIDE([Earned Value (EV)], [Actual Cost (AC)], BLANK())

// [Efficiency Index] Weighted portfolio schedule efficiency (SUM(EV)/SUM(PV)). Values < 1.0 signal slippage.
Schedule Performance Index (SPI) = DIVIDE([Earned Value (EV)], [Planned Value (PV)], BLANK())

// [Predictive Forecast] Projected total cost at completion assuming current CPI persists (BAC / CPI).
Estimate at Completion (EAC) = DIVIDE([Budget at Completion (BAC)], [Cost Performance Index (CPI)], [Budget at Completion (BAC)])

// [Predictive Forecast] Conservative executive forecast penalizing remaining work by both CPI and SPI.
EAC (Cost + Schedule Risk) = [Actual Cost (AC)] + DIVIDE([Budget at Completion (BAC)] - [Earned Value (EV)], [Cost Performance Index (CPI)] * [Schedule Performance Index (SPI)], 0)

// [Predictive Forecast] Projected budget surplus (+) or deficit (-) at project completion (BAC - EAC).
Variance at Completion (VAC) = [Budget at Completion (BAC)] - [Estimate at Completion (EAC)]

// [Predictive Forecast] Future cost efficiency required on remaining work to finish within original BAC. TCPI > 1.15 is virtually unrecoverable.
To-Complete Performance Index (TCPI) = DIVIDE([Budget at Completion (BAC)] - [Earned Value (EV)], [Budget at Completion (BAC)] - [Actual Cost (AC)], BLANK())

// [Workforce Capacity] Percentage of available regional engineering capacity billed to signed client SOWs.
Billable Utilization % = DIVIDE(SUM('fact_utilization_daily'[billable_hours]), SUM('fact_utilization_daily'[capacity_hours]), 0)

// [Workforce Capacity] Capacity invested in global pre-sales PoCs and reusable architectures (high-value ramp lever in emerging pods like MENA).
Global PoC & Accelerator Investment % = DIVIDE(SUM('fact_utilization_daily'[poc_investment_hours]), SUM('fact_utilization_daily'[capacity_hours]), 0)

// [Executive Matrix] 4-Quadrant Portfolio Risk Classification
EVM Health Quadrant = 
VAR _cpi = [Cost Performance Index (CPI)]
VAR _spi = [Schedule Performance Index (SPI)]
RETURN
SWITCH(
    TRUE(),
    ISBLANK(_cpi) || ISBLANK(_spi), "UNSTARTED",
    _cpi >= 1.0 && _spi >= 1.0, "Q1: Optimal (Under Budget & Ahead)",
    _cpi >= 0.92 && _spi >= 0.92, "Q2: Healthy Watchlist",
    _cpi < 0.92 && _spi >= 0.92, "Q3: Cost Overrun Risk",
    _cpi >= 0.92 && _spi < 0.92, "Q4: Schedule Slippage",
    "CRITICAL: Dual Cost & Schedule Breach"
)
