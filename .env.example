# Environment Mode (set DEMO_MODE=true for 100% offline local simulation)
DEMO_MODE=true

# AWS Cloud Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ENVIRONMENT=prod

# Streaming & S3 Open Data Lake
KINESIS_STREAM_NAME=evm-operational-events-stream
DATALAKE_BUCKET_NAME=enterprise-evm-lakehouse-prod
GLUE_DATABASE_NAME=evm_lakehouse_catalog

# Amazon Redshift Serverless
REDSHIFT_NAMESPACE_NAME=evm-enterprise-ns
REDSHIFT_WORKGROUP_NAME=evm-enterprise-wg
REDSHIFT_DATABASE_NAME=evm_dw
REDSHIFT_BASE_RPU=32

# Amazon QuickSight & Power BI Semantic Layer
QUICKSIGHT_PRINCIPAL_ARN=arn:aws:quicksight:us-east-1:123456789012:user/default/admin
DEFAULT_RLS_PERSONA=GLOBAL_CFO

# Databricks Unity Catalog (Delta UniForm Interoperability)
DATABRICKS_HOST=https://dbc-example.cloud.databricks.com
UNITY_CATALOG_NAME=evm_enterprise_prod
